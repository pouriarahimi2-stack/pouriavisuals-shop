  const payableAmount = Number(order?.finalAmount || order?.totalAmount || order?.total_amount || 0);

  return (
    <div className="min-h-[85vh] py-10 px-4 max-w-lg mx-auto font-sans select-none text-[var(--text-primary)]" dir="rtl">
