    const cleanSlug = String(body.slug || title)
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9\u0600-\u06FF]+/g, "-")
      .replace(/^-+|-+$/g, "");

    const img = body.imageUrl || body.image_url || "/placeholder.png";
    const metaDesc = body.metaDescription || body.meta_description || title;

    const payload = {
      title,
