      <form onSubmit={handleSubmit} className="bg-[var(--modal-bg)] p-6 md:p-8 rounded-3xl border border-[var(--card-border)] space-y-8 shadow-xl text-xs">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
