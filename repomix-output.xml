          })
        );
      }
    )
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'contact_messages' },
      (payload) => {
        window.dispatchEvent(
          new CustomEvent('contact_messages_updated', {
            detail: {
              eventType: payload.eventType,
              newRecord: payload.new,
              oldRecord: payload.old,
            },
          })
        );
      }
    )
    .on(
