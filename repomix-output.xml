                >
                  انصراف
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 rounded-xl bg-[var(--accent-blue)] text-white text-xs font-bold shadow-md hover:opacity-90 transition"
                >
                  ذخیره کوپن 💾
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
