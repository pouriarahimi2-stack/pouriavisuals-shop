                        {p.specs?.[specKey] || "---"}
                      </td>
                    ))}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <footer className="p-4 border-t border-[var(--card-border)] flex justify-end bg-[var(--input-bg)]">
          <button
            onClick={() => {
