    setLoadingSeo(true);
    try {
      const res = await fetch("/api/ai-seo-autopilot", { cache: "no-store" });
      const json = await res.json();
      if (json.success) setSeoData(json.data);
    } catch {} finally {
      setLoadingSeo(false);
    }
  };

