        className={\`flex flex-col items-center gap-1 transition \${pathname === "/products" ? "text-[var(--accent-blue)] scale-105" : "text-[var(--text-secondary)]"}\`}
      >
        <span className="text-base">📦</span>
        <span>محصولات</span>
      </Link>

      <button
