    return NextResponse.json({
      success: true,
      message: 'همگام‌سازی اخبار با موفقیت انجام شد.',
      count: freshNews?.length || 0,
    });
  } catch (err: any) {
    return NextResponse.json({ success: false, message: 'خطای سیستمی.' }, { status: 500 });
