  const masterChannel = supabase
    .channel('axon_master_realtime_sync')
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'products' },
      (payload) => {
        window.dispatchEvent(
          new CustomEvent('products_updated', {
            detail: {
              eventType: payload.eventType,
              newRecord: payload.new,
