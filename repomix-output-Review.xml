          role: "copilot",
          text: json.strategy,
          time: new Date().toLocaleTimeString("fa-IR")
        };
        const updated = [...messages, userMsg, copilotMsg];
        setMessages(updated);
        autoSaveSession(updated);
      }
    } finally {
      setGeneratingStrategy(false);
    }
