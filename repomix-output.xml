                    </div>
                  ) : (
                    <div className="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-xs leading-relaxed font-medium whitespace-pre-line text-emerald-600 dark:text-emerald-400">
                      {selectedMessage.admin_reply}
