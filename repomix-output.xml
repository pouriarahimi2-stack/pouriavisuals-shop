                  <form onSubmit={handleRegister} className="space-y-2.5 text-xs">
                    <div>
                      <label className="block mb-1 font-bold text-[var(--text-secondary)]">شماره موبایل *</label>
                      <input
                        type="tel"
                        required
                        dir="ltr"
                        maxLength={11}
                        value={regPhone}
