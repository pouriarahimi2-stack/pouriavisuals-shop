                  onClick={() => handleDelete(selectedPost.id!)}
                  className="px-6 py-4 rounded-2xl bg-rose-500/15 text-rose-600 dark:text-rose-400 font-bold text-xs hover:bg-rose-500 hover:text-white transition cursor-pointer"
                >
                  حذف مقاله ✕
                </button>
              )}
